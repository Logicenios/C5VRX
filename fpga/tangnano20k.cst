// ---- C5 sample link + control UART (docs/FPGA_LINK.md; fpga/README.md wiring table) ----
// Header pin numbers from Sipeed's Tang Nano 20K pinlabel figure (wiki.sipeed.com,
// tang/tang-nano-20k). All header banks are 3.3 V LVCMOS, like the C5.
// STROBE on 77 = GCLKT_1 (true global-clock input pin; shared with the unused LCD FPC LCD_CLK).
// HYSTERESIS=HIGH: without it the unterminated STROBE edge double-clocks the lclk domain in
// some placements (strobe count 40.01..40.74 MHz instead of 40.000236, both directions; the DSP
// chain then never finds H sync). Same placement with only this fuse set: exact count
// (docs/MEASUREMENTS.md M69).
IO_LOC  "link_strobe" 77;
IO_PORT "link_strobe" IO_TYPE=LVCMOS33 PULL_MODE=DOWN HYSTERESIS=HIGH;
// link_d[k] = PARLIO data bit k = C5-Zero GPIO {0,1,4,5,6,7,8,9}[k]; right header, top to bottom
IO_LOC  "link_d[0]" 42;
IO_PORT "link_d[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "link_d[1]" 41;
IO_PORT "link_d[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "link_d[2]" 56;
IO_PORT "link_d[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "link_d[3]" 54;
IO_PORT "link_d[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "link_d[4]" 51;
IO_PORT "link_d[4]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "link_d[5]" 48;
IO_PORT "link_d[5]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "link_d[6]" 55;
IO_PORT "link_d[6]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "link_d[7]" 49;
IO_PORT "link_d[7]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
// UART: link_rx <- C5 GPIO11 (UART1 TX), link_tx -> C5 GPIO12 (UART1 RX); idle high
IO_LOC  "link_rx" 72;
IO_PORT "link_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "link_tx" 71;
IO_PORT "link_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// ---- debug: FPGA -> C5 link traffic mirrored to the BL616 USB-UART (Sipeed example: FPGA TX = pin 69) ----
IO_LOC  "dbg_tx" 69;
IO_PORT "dbg_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
