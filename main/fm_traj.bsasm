# Trajectory v2: two-bundle weak-signal WBFM experiment.
#
# Input: full packed Q4/I4 @ 40 MS/s (two bytes per 50 ns output).
# Output: 20 MS/s unique 6-bit CVBS duplicated [D,D] on the proven 40 MHz DAC.
#
# Unlike Golden Phase5, the trajectory LUT is trained against:
#   d0 = wrap(phi_middle - phi_previous)
#   d1 = wrap(phi_current - phi_middle)
#   target = map(d0 + d1)
# and d0+d1 is deliberately NOT wrapped again.
#
# Realtime address (10 bits):
#   bits 0..4 : previous full Phase5 state
#   bit  5    : middle raw-Q LSB trajectory hint
#   bits 6..9 : current Phase5[4:1]
#
# The current full Phase5 state is still retained in O26..O30 for the next
# output, so only the lookup address drops its LSB. This tested better than the
# older phase4+quadrant+phase4 trajectory compression in synthetic weak-FM
# sweeps while remaining exactly two bundles/output.
#
# The first two instructions only prime the pipeline. Steady state is:
#   trajectory -> emit -> trajectory -> emit ...
#
# The unused physical DAC MSB (bit 15) carries the one-bit middle hint as
# internal state; GPIO bit 7 is unconnected in 6-bit mode.
cfg prefetch true
cfg eof_on downstream
cfg trailing_bytes 0
cfg lut_width_bits 16
lut 1047 1553 1805 1801 1801 2058 2061 2062 6160 6162 6164 6422 6425 6428 6686 7199 544 1058 1316 1574 1577 1835 1837 1838 6447 6448 6447 6700 6696 6949 7200 7708 279 786 1037 1289 1289 1546 1548 1549 6671 6672 6673 6931 6934 7192 7450 7964 286 543 800 1059 1318 1320 1322 1580 6702 6959 6958 6956 7208 7461 7712 7964 289 540 791 786 1039 1292 1290 1291 6925 6926 6928 7186 7446 7448 7706 7964 29 287 545 803 806 1063 1065 1323 6956 7213 7215 7216 7471 7725 7977 37 33 284 535 786 783 1035 1033 1034 7179 7180 7181 7439 7442 7700 7959 24 26 283 541 543 802 804 1062 1064 7210 7212 7469 7471 7727 7725 7977 37 4136 3876 3616 3611 3351 3346 3086 3083 5129 5130 4876 4878 4625 4627 4374 4119 4120 3866 3612 3358 3361 3107 3109 3110 5159 5160 5162 4908 4910 4656 4399 4140 4136 3876 3616 3355 3351 3090 3085 2825 5383 5128 5129 4875 4878 4624 4370 4115 3862 3606 3352 3354 3101 3104 2850 2852 5413 5415 5417 5163 4910 4912 4655 4396 3886 3626 3367 3107 2848 2844 2838 2578 5645 5385 5383 5384 5132 4878 4624 4370 3859 3349 3095 2840 2844 2589 2591 2592 5666 5667 5668 5414 5416 5164 4909 4399 3630 3116 2856 2596 2593 2332 2326 2322 5901 5896 5894 5638 5641 5388 5134 4623 3089 2578 2324 2326 2329 2075 2077 2080 6177 6179 6181 5927 5930 5933 5679 5168 46 46 45 42 40 37 32 28 23 18 14 10 9 11 13 15 15 17 19 21 24 26 28 29 30 32 33 35 37 40 42 44 47 48 47 44 42 38 33 28 23 18 13 9 8 9 11 13 15 16 17 19 23 25 27 29 31 32 34 36 39 42 44 46 42 43 44 46 47 44 40 37 32 28 23 18 15 11 10 11 11 13 15 17 20 22 24 25 26 28 29 31 33 36 38 40 44 46 47 49 49 46 42 38 33 28 23 18 14 10 9 10 12 13 14 16 20 22 24 26 28 29 31 33 36 39 41 43 36 37 39 41 44 46 45 43 39 35 32 27 22 18 13 9 7 8 10 12 15 17 18 20 21 22 24 25 28 31 33 34 39 41 43 45 48 49 48 44 40 36 32 27 22 18 13 9 8 8 10 12 15 17 19 21 23 25 26 29 31 35 37 38 32 33 35 37 40 43 45 46 45 43 40 36 32 28 22 18 13 9 7 7 11 12 14 15 17 18 19 21 23 27 28 30 35 37 38 41 44 46 48 49 47 44 40 36 33 28 22 18 14 9 7 8 11 13 15 17 19 20 22 25 27 30 32 34 29 30 32 34 37 40 42 44 46 47 47 44 41 37 32 28 23 18 14 10 9 10 11 13 14 15 17 18 21 24 26 27 32 34 35 37 41 43 45 46 47 48 47 44 41 37 32 28 23 17 13 9 8 10 12 14 15 17 19 21 24 27 29 31 26 26 28 30 34 36 39 40 42 44 46 47 48 45 41 37 32 28 23 18 15 10 8 9 10 11 13 15 17 20 22 23 28 30 32 34 37 39 41 43 44 45 46 48 48 45 41 37 33 28 23 18 15 11 9 10 12 14 15 18 21 24 26 27 21 22 24 26 30 32 35 36 38 40 42 44 47 49 47 44 40 36 32 27 23 18 13 9 7 7 9 11 13 16 18 19 24 26 27 30 33 35 37 38 39 41 42 44 47 49 47 44 41 36 32 27 23 18 14 10 9 9 11 14 16 19 21 23 17 18 20 22 25 28 30 32 34 35 38 40 43 45 48 49 47 44 41 37 33 28 22 18 13 8 6 7 9 12 14 15 19 21 22 25 28 30 32 33 34 36 37 39 42 44 46 47 47 43 40 36 32 28 22 18 13 9 7 9 11 14 16 18 15 15 17 19 23 25 28 29 31 33 35 37 40 43 45 46 47 49 48 45 42 37 33 28 23 18 13 9 7 9 11 13 15 17 19 21 25 27 28 30 31 32 34 35 38 41 43 44 46 47 46 43 40 36 32 28 23 18 14 10 8 11 13 15 12 12 14 16 20 22 25 26 28 30 32 34 37 40 42 43 44 46 48 49 50 46 42 38 33 28 23 18 13 11 9 9 11 13 15 17 21 22 24 26 27 28 30 31 34 37 39 40 42 43 45 46 47 44 40 37 32 28 23 18 14 11 10 10 9 8 10 12 16 18 21 22 24 26 28 30 33 35 38 39 40 42 44 46 49 50 48 45 41 37 32 27 22 18 13 10 7 9 10 12 16 18 19 21 22 23 25 26 29 32 34 35 37 38 40 42 45 47 46 43 39 36 32 27 22 18 13 10 14 9 7 8 11 14 16 18 20 21 23 25 29 31 33 35 36 38 39 41 45 46 48 49 47 44 41 36 32 28 22 18 13 9 6 7 11 13 15 16 17 19 20 22 25 27 29 31 33 34 35 37 41 43 45 46 45 43 40 36 32 28 22 18

prime_lookup:
    # Lookup the first retained endpoint (second byte of the prefetched pair).
    set 16..23 8..15,
    set 24..25 L,
    read 16

prime_store:
    # Save endpoint Phase5 as previous state, then lookup the next endpoint.
    # Input bits now hold [middle,current] for the next 50 ns output.
    set 26..30 L8..L12,
    set 15 0,
    set 16..23 8..15,
    set 24..25 L,
    set 31 L,
    read 16

trajectory:
    # Preserve full current Phase5 for next time while addressing the
    # compressed exact-adjacent trajectory estimator.
    set 26..30 L8..L12,
    set 15 O15,
    set 16..20 O26..O30,
    set 21 O15,
    set 22..25 L9..L12,
    set 31 L

emit:
    # Duplicate one 6-bit 20 MS/s CVBS target onto the proven [D,D] transport.
    # Simultaneously prefetch the following pair and save its middle hint.
    set 0..5 L0..L5,
    set 6..7 L,
    set 8..13 L0..L5,
    set 14 L,
    set 15 0,
    set 26..30 O26..O30,
    set 16..23 8..15,
    set 24..25 L,
    set 31 L,
    read 16,
    write 16,
    jmp trajectory
